{
  "name": "tutu-okno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem next dev",
    "build": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem next build --webpack",
    "start": "NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca.pem next start",
    "test": "vitest run lib/feasibility lib/ideas lib/travel-search lib/polls lib/manual-event-service.test.ts lib/repositories/postgres-calendar-repository.integration.test.ts && node --import tsx --test lib/conflict-repository.test.ts lib/free-windows.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "0.468.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "postcss": "8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.3.0",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4"
  }
}
