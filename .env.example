DATABASE_URL=postgresql://tutu_okno:tutu_okno@localhost:5433/tutu_okno

# GigaChat: use the long-lived Authorization key from Sber Studio.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# For a quick check you may use a ready access token instead. It expires in 30 minutes.
# GIGACHAT_ACCESS_TOKEN=
# GIGACHAT_API_URL=https://api.giga.chat
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional override. Normal mode already uses this public endpoint by default.
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
